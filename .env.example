# Copy to .env and adjust. Every value shown is the default.

# Bind address. Loopback means the panel is reachable only from this machine and
# no login is required. Anything else counts as exposed and forces authentication.
GCA_HOST=127.0.0.1
GCA_PORT=3210

# Where the database, master key, bridge token and device backups live.
# Defaults to the platform application-data directory when unset.
# GCA_DATA_DIR=/path/to/data

GCA_LOG_LEVEL=info

# Use a mounted secret instead of the generated key file. Required if you want
# secrets to survive a container rebuild that discards the data volume.
# GCA_MASTER_KEY_FILE=/run/secrets/gca_master_key

# Set when running behind a reverse proxy.
# GCA_PUBLIC_BASE_URL=https://displays.example.internal
# GCA_TRUST_PROXY=false
