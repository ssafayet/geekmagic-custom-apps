# Optional. Copy to `.env` (cp .env.example .env) to change a default; every line
# here is commented out, so an unedited copy changes nothing. `pnpm start`, the
# `pnpm bridge:*` commands and `docker compose` all read this one file.

# --- Reaching the web UI ----------------------------------------------------

# Native install: the address the server listens on. 127.0.0.1 means this machine
# only, with no login. 0.0.0.0 makes it reachable from your phone and other
# computers; a login is then required, set up with the code the log prints.
# GCA_HOST=127.0.0.1

# Docker: the address the published port listens on. Same meaning as GCA_HOST
# above, and it is what decides whether the container asks for a login.
# GCA_PUBLISH_ADDRESS=127.0.0.1

# GCA_PORT=3210

# --- Claude Code status-line bridge -----------------------------------------

# Needed only when the server runs in Docker: the container and the host-side
# bridge (tools/claude-bridge.sh) both read it from this file. Generate one with:
# openssl rand -hex 32. After changing it run `docker compose up -d`; a restart
# keeps the old value. A native install creates and shares its own automatically.
# GCA_BRIDGE_TOKEN=

# Accept bridge posts from any private address, not only loopback. compose.yaml
# turns this on because Docker's NAT rewrites the source; a native install never
# needs it.
# GCA_BRIDGE_ALLOW_PRIVATE_SOURCES=false

# --- Storage ----------------------------------------------------------------

# Database, master key, bridge token and device backups. Defaults to the platform
# application-data directory. Ignored by Docker, which always uses its volume.
# GCA_DATA_DIR=/path/to/data

# Use your own key file instead of the generated one. Native installs only: in
# Docker, uncomment the two master-key lines in compose.yaml instead, so secrets
# survive a rebuild that discards the data volume. See docs/DEPLOYMENT.md.
# GCA_MASTER_KEY_FILE=/path/to/master.key

# GCA_LOG_LEVEL=info

# --- Behind a reverse proxy ---------------------------------------------------

# Any of these, or GCA_ALLOWED_HOSTS below, turns the login on, even with the app
# bound to loopback.
# GCA_PUBLIC_BASE_URL=https://displays.example.com
# true = a proxy on this machine; otherwise the proxy's IP or CIDR, comma-separated.
# GCA_TRUST_PROXY=false

# Extra hostnames to answer to. Local names (localhost, IPs, *.local, *.lan, single
# labels) always work; only a public DNS name needs listing here, and listing one
# turns the login on.
# GCA_ALLOWED_HOSTS=displays.example.com

# --- Overrides you should rarely need -----------------------------------------

# Force the login on or off regardless of the address. Leave unset: the defaults
# above already do the right thing natively and in Docker.
# GCA_AUTH_REQUIRED=
