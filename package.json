{
  "name": "geekmagic-custom-apps",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local server that renders information modules to 240x240 images and pushes them to stock GeekMagic displays.",
  "license": "MIT",
  "engines": {
    "node": ">=22.11.0"
  },
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "build": "pnpm -r run build",
    "typecheck": "tsc -b --pretty",
    "dev": "pnpm --filter @gca/server run dev",
    "dev:web": "pnpm --filter @gca/web run dev",
    "start": "node --env-file-if-exists=.env apps/server/dist/main.js",
    "db:migrate": "tsx --conditions=development apps/server/src/cli/migrate.ts",
    "auth:reset": "node --env-file-if-exists=.env apps/server/dist/cli/reset-password.js",
    "bridge": "node --env-file-if-exists=.env tools/claude-statusline-bridge/dist/cli.js",
    "bridge:install": "node --env-file-if-exists=.env tools/claude-statusline-bridge/dist/cli.js install",
    "bridge:uninstall": "node --env-file-if-exists=.env tools/claude-statusline-bridge/dist/cli.js uninstall",
    "bridge:status": "node --env-file-if-exists=.env tools/claude-statusline-bridge/dist/cli.js status",
    "bridge:doctor": "node --env-file-if-exists=.env tools/claude-statusline-bridge/dist/cli.js doctor",
    "bridge:push": "node --env-file-if-exists=.env tools/claude-statusline-bridge/dist/cli.js push",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "find . -name 'dist' -type d -not -path './node_modules/*' -not -path '*/node_modules/*' -prune -exec rm -rf {} + ; find . -name '*.tsbuildinfo' -not -path '*/node_modules/*' -delete"
  },
  "devDependencies": {
    "@gca/core": "workspace:*",
    "@gca/database": "workspace:*",
    "@gca/device-core": "workspace:*",
    "@gca/module-adsb-monitor": "workspace:*",
    "@gca/module-calendar": "workspace:*",
    "@gca/module-claude-usage": "workspace:*",
    "@gca/module-sdk": "workspace:*",
    "@gca/module-weather": "workspace:*",
    "@gca/renderer": "workspace:*",
    "@gca/secrets": "workspace:*",
    "@gca/shared": "workspace:*",
    "@types/node": "^22.10.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
